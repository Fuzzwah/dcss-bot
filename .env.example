# Copy with: cp .env.example .env
# Never commit .env. Omit BOT_PASSWORD to generate a private local credential.
DCSS_URL=ws://127.0.0.1:8080/socket
DCSS_GAME_ID=dcss
DCSS_SEEDED_GAME_ID=dcss-seeded
BOT_USERNAME=MiBeBot
# BOT_PASSWORD=
# Species/background module; MiBe is currently the only built-in combination.
BOT_CHARACTER=mibe
BOT_AGENT=rule
# Fixed seed only for a NEW account; omit when resuming an existing save.
# BOT_SEED=12345
ACTION_DELAY=0.4
MAX_ACTIONS=10000
MAX_TURNS=10000
RUN_DIR=runs
CONTROL_SOCKET=state/control.sock
RECORD_VIDEO=false
